<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NOT in Gg2.sln, the same way tools/bench is not: this is a measurement and
    stress instrument, not shipped code, and a `dotnet test Gg2.sln` should not
    build it. Build it explicitly, as tools/soak/README.md shows.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>soak-players</AssemblyName>
    <RootNamespace>Gg2.Soak</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Gg2.Protocol and nothing else. The handshake, the message ids and the
      quantisation are already implemented and tested there; hand-rolling them
      here would be a second implementation of the wire whose bugs would read as
      the server's.
    -->
    <ProjectReference Include="../../src/Gg2.Protocol/Gg2.Protocol.csproj" />
  </ItemGroup>

</Project>
