<Project Sdk="Microsoft.NET.Sdk">

  <!-- The rollback engine: one node of a multi-region match.

       ⚠️ NO I/O, for the same reason Gg2.Simulation has none. A node's whole
       job is to be a pure function of (state, inputs, arrival order), and that
       is what lets two of them be run in one process against a scripted link
       and asserted to converge. The sockets that carry inputs between real
       nodes belong in Gg2.Server, above this.

       It does NOT depend on Gg2.Bots: a node does not care whether an input
       came from a person, a bot or a recording. -->
  <PropertyGroup>
    <RootNamespace>Gg2.Mesh</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gg2.Protocol\Gg2.Protocol.csproj" />
    <ProjectReference Include="..\Gg2.Maps\Gg2.Maps.csproj" />
    <ProjectReference Include="..\Gg2.Simulation\Gg2.Simulation.csproj" />
  </ItemGroup>

</Project>
