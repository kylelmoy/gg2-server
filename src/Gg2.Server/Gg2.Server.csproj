<Project Sdk="Microsoft.NET.Sdk">

  <!-- The only project with I/O in it. docs/ARCHITECTURE.md:
       Gg2.Simulation must never reference this one. The dependency runs one
       way, which is what keeps the simulation runnable with no server at all
       and therefore replayable by Gg2.Parity. -->
  <PropertyGroup>
    <RootNamespace>Gg2.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gg2.Protocol\Gg2.Protocol.csproj" />
    <ProjectReference Include="..\Gg2.Maps\Gg2.Maps.csproj" />
    <ProjectReference Include="..\Gg2.Simulation\Gg2.Simulation.csproj" />

    <!--
      ⚠️ Gg2.Server depends on Gg2.Bots, and NOT the other way round. The
      population manager is server-side in the reference (botPopulationUpdate is
      called from GameServer's Begin Step) because only the server has a roster,
      a config file and a socket to broadcast a join on. Gg2.Bots stays pure and
      gains nothing from this edge.

      docs/ARCHITECTURE.md's one hard rule is that Gg2.Simulation must not
      reference Gg2.Server, and that is untouched.
    -->
    <ProjectReference Include="..\Gg2.Bots\Gg2.Bots.csproj" />

    <!--
      The nav-graph generator, so a map with no checked-in graph still gets one
      (BotPopulationService.MapChanged). Gg2.Nav does NOT reference Gg2.Bots:
      it produces the cache file's text and NavCache.Parse turns that into a
      NavGraph, which is the same call a file off disk gets. One direction, no
      cycle, and an on-the-fly graph is the file's graph by construction.
    -->
    <ProjectReference Include="..\Gg2.Nav\Gg2.Nav.csproj" />
  </ItemGroup>


  <!--
    The web admin panel's five files, compiled in. WebAssets says why they are
    embedded rather than served off disk; the short version is that a deployment
    cannot then have a working binary and a missing page, and that there is no
    directory to traverse.
    ⚠️ LogicalName is set by hand rather than left to the default
    <RootNamespace>.<folder>.<file> derivation, because that derivation mangles a
    name with a dot in it and every one of these has one.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Web\Assets\index.html" LogicalName="Gg2.Server.Web.Assets.index.html" />
    <EmbeddedResource Include="Web\Assets\app.css" LogicalName="Gg2.Server.Web.Assets.app.css" />
    <EmbeddedResource Include="Web\Assets\app.js" LogicalName="Gg2.Server.Web.Assets.app.js" />
    <EmbeddedResource Include="Web\Assets\favicon.svg" LogicalName="Gg2.Server.Web.Assets.favicon.svg" />

    <!--
      The analytics map's geometry: Natural Earth coastlines, country markers
      and US states, already projected into a unit box. Public domain, generated
      by tools/gen-geo-assets.js, and CHECKED IN rather than fetched at runtime —
      the panel has to work on a machine with no route to the internet, which is
      the same argument that keeps everything above out of a CDN.
    -->
    <EmbeddedResource Include="Web\Assets\world.json" LogicalName="Gg2.Server.Web.Assets.world.json" />
  </ItemGroup>

  <!-- So IdleServerTests can read PacingInterval without timing Run(). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Gg2.Tests" />
  </ItemGroup>

</Project>
