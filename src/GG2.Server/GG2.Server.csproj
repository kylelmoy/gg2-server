<Project Sdk="Microsoft.NET.Sdk">

  <!-- The only project with I/O in it. docs/ARCHITECTURE.md:
       GG2.Simulation must never reference this one. The dependency runs one
       way, which is what keeps the simulation runnable with no server at all
       and therefore replayable by GG2.Parity. -->
  <PropertyGroup>
    <RootNamespace>GG2.Server</RootNamespace>

    <!-- A -p:Version from the command line (release.yml, the Dockerfile).
         Read here, before the SDK's targets default Version to 1.0.0. -->
    <_Gg2ExplicitVersion>$(Version)</_Gg2ExplicitVersion>
  </PropertyGroup>

  <!--
    BuildInfo.Version, which the version flag prints and the lobby announces, is this
    assembly's version. With no -p:Version it is the nearest v<x.y.z> tag
    reachable from HEAD, so a scripts/deploy.sh build of a commit past v1.1.1
    says 1.1.1 (BuildInfo.Commit says which commit). With no git or no tag it
    stays at the SDK's 1.0.0.
  -->
  <Target Name="VersionFromGitTag" BeforeTargets="GetAssemblyVersion" Condition="'$(_Gg2ExplicitVersion)' == ''">
    <Exec Command="git describe --tags --match &quot;v[0-9]*&quot; --abbrev=0"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_Gg2Tag" />
      <Output TaskParameter="ExitCode" PropertyName="_Gg2TagExit" />
    </Exec>
    <PropertyGroup Condition="'$(_Gg2TagExit)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_Gg2Tag)', '^v\d+\.\d+\.\d+$'))">
      <Version>$(_Gg2Tag.Substring(1))</Version>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\GG2.Protocol\GG2.Protocol.csproj" />
    <ProjectReference Include="..\GG2.Maps\GG2.Maps.csproj" />
    <ProjectReference Include="..\GG2.Simulation\GG2.Simulation.csproj" />

    <!--
      ⚠️ GG2.Server depends on GG2.Bots, and NOT the other way round. The
      population manager is server-side in the reference (botPopulationUpdate is
      called from GameServer's Begin Step) because only the server has a roster,
      a config file and a socket to broadcast a join on. GG2.Bots stays pure and
      gains nothing from this edge.

      docs/ARCHITECTURE.md's one hard rule is that GG2.Simulation must not
      reference GG2.Server, and that is untouched.
    -->
    <ProjectReference Include="..\GG2.Bots\GG2.Bots.csproj" />

    <!--
      The nav-graph generator, so a map with no checked-in graph still gets one
      (BotPopulationService.MapChanged). GG2.Nav does NOT reference GG2.Bots:
      it produces the cache file's text and NavCache.Parse turns that into a
      NavGraph, which is the same call a file off disk gets. One direction, no
      cycle, and an on-the-fly graph is the file's graph by construction.
    -->
    <ProjectReference Include="..\GG2.Nav\GG2.Nav.csproj" />
  </ItemGroup>


  <!--
    The web admin panel's files, compiled in. WebAssets says why they are
    embedded rather than served off disk; the short version is that a deployment
    cannot then have a working binary and a missing page, and that there is no
    directory to traverse.
    ⚠️ LogicalName is set by hand rather than left to the default
    <RootNamespace>.<folder>.<file> derivation, because that derivation mangles a
    name with a dot in it and every one of these has one.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Web\Assets\index.html" LogicalName="GG2.Server.Web.Assets.index.html" />
    <EmbeddedResource Include="Web\Assets\app.css" LogicalName="GG2.Server.Web.Assets.app.css" />
    <EmbeddedResource Include="Web\Assets\app.js" LogicalName="GG2.Server.Web.Assets.app.js" />
    <EmbeddedResource Include="Web\Assets\strings.js" LogicalName="GG2.Server.Web.Assets.strings.js" />
    <EmbeddedResource Include="Web\Assets\common.js" LogicalName="GG2.Server.Web.Assets.common.js" />
    <EmbeddedResource Include="Web\Assets\analytics.js" LogicalName="GG2.Server.Web.Assets.analytics.js" />
    <EmbeddedResource Include="Web\Assets\settings.js" LogicalName="GG2.Server.Web.Assets.settings.js" />
    <EmbeddedResource Include="Web\Assets\favicon.svg" LogicalName="GG2.Server.Web.Assets.favicon.svg" />

    <!--
      The panel's three typefaces, latin subset, SIL Open Font License 1.1 (the
      licence files sit beside them). Embedded for the no-CDN reason above;
      WebAssets.Fonts is the route table.
    -->
    <EmbeddedResource Include="Web\Assets\fonts\oswald.woff2" LogicalName="GG2.Server.Web.Assets.fonts.oswald.woff2" />
    <EmbeddedResource Include="Web\Assets\fonts\rubik.woff2" LogicalName="GG2.Server.Web.Assets.fonts.rubik.woff2" />
    <EmbeddedResource Include="Web\Assets\fonts\space-mono-400.woff2" LogicalName="GG2.Server.Web.Assets.fonts.space-mono-400.woff2" />
    <EmbeddedResource Include="Web\Assets\fonts\space-mono-700.woff2" LogicalName="GG2.Server.Web.Assets.fonts.space-mono-700.woff2" />

    <!--
      gg2-server config edit's page — ConfigEditorServer. It runs on the
      operator's machine, not a server, and borrows app.css, common.js,
      settings.js and the favicon. A fleet hub serves the same page at
      /fleet/settings.
    -->
    <EmbeddedResource Include="Web\Assets\editor.html" LogicalName="GG2.Server.Web.Assets.editor.html" />
    <EmbeddedResource Include="Web\Assets\editor.css" LogicalName="GG2.Server.Web.Assets.editor.css" />
    <EmbeddedResource Include="Web\Assets\editor.js" LogicalName="GG2.Server.Web.Assets.editor.js" />

    <!--
      The analytics map's geometry: Natural Earth coastlines, country markers
      and US states, already projected into a unit box. Public domain, generated
      by tools/gen-geo-assets.js, and CHECKED IN rather than fetched at runtime —
      the panel has to work on a machine with no route to the internet, which is
      the same argument that keeps everything above out of a CDN.
    -->
    <EmbeddedResource Include="Web\Assets\world.json" LogicalName="GG2.Server.Web.Assets.world.json" />
  </ItemGroup>

  <!-- So IdleServerTests can read PacingInterval without timing Run(). -->
  <ItemGroup>
    <InternalsVisibleTo Include="GG2.Tests" />
  </ItemGroup>

</Project>
