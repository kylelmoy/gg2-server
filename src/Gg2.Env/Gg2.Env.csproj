<Project Sdk="Microsoft.NET.Sdk">

  <!-- The batch-stepping surface for a learned policy. docs/ENV.md is the
       design; docs/BOTAI.md item 10 is why it exists.

       Depends on Gg2.Bots for ScenarioWorld — the gamemode-less duel (item 11)
       this wraps — and through it on Gg2.Simulation and Gg2.Maps. It does NOT
       depend on Gg2.Server: an env is not a game server, and the whole point of
       the seam is that a policy can be stepped without a socket.

       ⚠️ It DOES have file I/O, like Gg2.Bots: a map is read off disk. The
       no-I/O rule is Gg2.Simulation's alone. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Gg2.Env</RootNamespace>
    <AssemblyName>gg2-env</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gg2.Protocol\Gg2.Protocol.csproj" />
    <ProjectReference Include="..\Gg2.Maps\Gg2.Maps.csproj" />
    <ProjectReference Include="..\Gg2.Simulation\Gg2.Simulation.csproj" />
    <ProjectReference Include="..\Gg2.Bots\Gg2.Bots.csproj" />

    <!-- For HumanDataset: replaying a recorded trace back into a world is
         Gg2.Parity's Replayer, and building a second one here would be a second
         answer to "what did this recording mean". The direction is deliberate -
         the training seam depends on the parity harness, never the reverse: the
         harness is what proves the physics, and a bot-layer compile error must
         not be able to stop it running. -->
    <ProjectReference Include="..\Gg2.Parity\Gg2.Parity.csproj" />
  </ItemGroup>

</Project>
