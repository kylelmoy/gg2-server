<Project Sdk="Microsoft.NET.Sdk">

  <!-- The simulation has NO I/O. No sockets, no clock, no async, no file
       access. Enforced by the project references below: Gg2.Protocol and
       Gg2.Maps are both pure, and Gg2.Server is deliberately absent.

       This is what makes the parity harness and the bot iteration loop
       possible. If it breaks, the project loses its main advantage over the
       GM8 server. -->
  <PropertyGroup>
    <RootNamespace>Gg2.Simulation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gg2.Protocol\Gg2.Protocol.csproj" />
    <ProjectReference Include="..\Gg2.Maps\Gg2.Maps.csproj" />
  </ItemGroup>

</Project>
