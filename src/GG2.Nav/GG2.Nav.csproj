<Project Sdk="Microsoft.NET.Sdk">

  <!-- The nav-graph GENERATOR: a map PNG in, a nav cache file out, with no game
       and no reference checkout.

       ⚠️ It deliberately does NOT reference GG2.Bots, which owns the READER.
       The generator's product is the cache file's text, and the server turns
       that into a NavGraph with NavCache.Parse — the same call it makes for a
       file off disk. So an on-the-fly graph is bit-identical to the one
       `gg2-server navgen` would have written, by construction rather than by
       two code paths agreeing.

       It has no I/O of its own either: NavGenerator takes a LevelMap and hands
       back a string. Writing it to a directory is NavCacheWriter's job, and
       that is the only file access in here. -->
  <PropertyGroup>
    <RootNamespace>GG2.Nav</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GG2.Protocol\GG2.Protocol.csproj" />
    <ProjectReference Include="..\GG2.Maps\GG2.Maps.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GG2.Tests" />
  </ItemGroup>

</Project>
