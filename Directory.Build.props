<Project>

  <!-- Everything in the repo is net10.0, nullable, and warnings-as-errors.
       docs/ARCHITECTURE.md, "Runtime settings".
       ⚠️ tools/bench/bench.csproj carries its OWN copy of this TFM, because it
       is deliberately not in Gg2.sln. Move both or the bench stops building. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
