# Build output
bin/
obj/
*.user
artifacts/
TestResults/

# Local recordings (--record) and captured traces
traces/
*.trace
*.gg2trace

# ...except the recordings the tests are built on. Those are oracles, not
# scratch data: without this a fresh clone fails tests that pass on the machine
# that recorded them.
!tests/Gg2.Tests/Fixtures/*.trace

# Fleet analytics collected by the operator's scripts. Player names; never commit.
deploy/analytics/

# The operator's own host tooling (fleet deploy, build wrappers, tunnels). It is
# specific to one set of hosts and not part of the project. Anchored with a
# leading slash so a src/Something/scripts/ is not ignored by accident.
/scripts/
